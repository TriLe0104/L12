FROM node:22-bookworm-slim AS frontend-builder

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci
COPY frontend ./

# Browser requests use the Render service's own origin. Nginx routes /api and
# /uploads to FastAPI and everything else to Next.js.
ARG NEXT_PUBLIC_API_BASE=
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build


FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NEXT_TELEMETRY_DISABLED=1

RUN apt-get update \
    && apt-get install --no-install-recommends -y gettext-base libstdc++6 nginx \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=frontend-builder /usr/local/bin/node /usr/local/bin/node
COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY backend/app ./backend/app
# Traveler Office templates plus the pre-rendered 3-page PDF background. The
# background can only be produced by Word/Excel COM, so it ships as a built
# asset; without it Linux would fall back to the plain PDF renderer and the
# DOCX/XLSX downloads would fail outright.
COPY backend/templates ./backend/templates
COPY --from=frontend-builder /app/.next/standalone ./frontend
COPY --from=frontend-builder /app/.next/static ./frontend/.next/static
COPY --from=frontend-builder /app/public ./frontend/public
COPY deploy/nginx.conf.template /etc/nginx/templates/po-calendar.conf.template
COPY deploy/start-render.sh ./start-render.sh

RUN sed -i 's/\r$//' ./start-render.sh \
    && chmod +x ./start-render.sh \
    && rm -f /etc/nginx/sites-enabled/default

EXPOSE 10000
CMD ["./start-render.sh"]
