# Local dev falls back to SQLite when this is unset.
DATABASE_URL=postgresql+psycopg://po:po@localhost:5432/po_calendar

JWT_SECRET=change-me-in-staging
JWT_EXPIRE_MINUTES=720

# local | entra | auth0  (only "local" is implemented in the prototype)
AUTH_PROVIDER=local

# Public sign-up is disabled. An authenticated admin creates accounts.
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_AUDIENCE=

SEED_ON_START=true
BOOTSTRAP_ADMIN_NAME=Demo Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
CORS_ORIGINS=http://localhost:3000

# Optional S3-compatible object storage (Cloudflare R2 recommended for the free
# demo). When set, uploads survive Render idle wakes and redeploys. Leave blank
# for local disk under backend/uploads/.
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=po-calendar-uploads
# S3_REGION=auto
# Optional public CDN / r2.dev base — when set, the API returns absolute URLs.
# S3_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
