# Local dev falls back to SQLite when this is unset.
DATABASE_URL=postgresql+psycopg://po:po@localhost:5432/po_calendar

JWT_SECRET=change-me-in-staging
JWT_EXPIRE_MINUTES=720

# local | entra | auth0  (only "local" is implemented in the prototype)
AUTH_PROVIDER=local

# Self-service sign-up. The prototype hands new accounts admin so you can set the
# board up yourself -- drop this to "viewer" (or ALLOW_SIGNUP=false) before staging.
ALLOW_SIGNUP=true
SIGNUP_DEFAULT_ROLE=admin
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_AUDIENCE=

SEED_ON_START=true
CORS_ORIGINS=http://localhost:3000
